# Copy this file to .env and adjust values. Never commit the real .env.

# --- Database ---
# Local dev default is a SQLite file next to the app. For production use PostgreSQL:
#   DATABASE_URL=postgresql://polarlogix:CHANGE_ME@db:5432/polarlogix
DATABASE_URL=sqlite:///./polarlogix.db

# --- Security ---
# Generate a real secret before any real deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-please-32-bytes-min
ACCESS_TOKEN_MINUTES=480
REFRESH_TOKEN_DAYS=14

# --- Demo data ---
# true  -> seeds the synthetic demo dataset (4 missions, 37 personnel, 126 assets, ...)
# false -> starts with an empty database; set ADMIN_USERNAME/ADMIN_PASSWORD to create
#          exactly one real admin account instead
SEED_DEMO_DATA=true
DEMO_PASSWORD=polar2026
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Demo heartbeat: keeps seeded field teams checking in automatically so a long-running
# demo deployment doesn't drift into a permanent "missed check-in". Off by default.
DEMO_MODE=false

# --- CORS ---
# Comma-separated list of allowed origins if the frontend is hosted separately.
# Leave empty when the API serves its own frontend (the default setup in this repo).
CORS_ORIGINS=

# --- Demo satellite-link simulation ---
# When true, requests to /api/sync/* that carry header `X-Link-Sim: sat` are delayed
# to resemble a ~1 KB/s satellite link. Used by the "Demo steps" walkthrough.
ALLOW_LINK_SIM=true
